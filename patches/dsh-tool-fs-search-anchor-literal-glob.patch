 /**
+* Anchor a literal-first-segment glob at any depth under a search root, so it
+* resolves against that root instead of the process CWD.
+*
+* ripgrep matches a `--glob` pattern against each path AS PRINTED — relative to
+* the process CWD (or absolute outside it), never relative to the search-root
+* argument. A pattern whose first segment is a literal directory name
+* (`dshd-orchestration/**`, `src/*.ts`) is therefore anchored at the CWD: under
+* a `path` root the printed paths carry the root prefix
+* (`packages/dshd-orchestration/...`) and the root-relative pattern silently
+* finds nothing although the files exist. Rewriting the pattern with a leading
+* any-depth `**` prefix makes it match at any depth, so it resolves against the
+* search root wherever ripgrep anchors its print.
+*
+* Only a pattern whose first segment is fully literal (no glob metacharacters
+* `* ? [ ] { } !`) is rewritten: a basename-only or `**`-leading pattern
+* already matches at any depth, a metacharacter-first pattern carries its own
+* matching semantics, a leading-`/` pattern is an explicit root glob, and a
+* pattern without a `path` keeps the CWD as its documented root — all pass
+* through untouched (zero regression).
+*
+* @param pattern - the model-provided glob pattern.
+* @param path - the search-root argument, or `undefined` when absent.
+* @returns the pattern ripgrep should receive.
+*/
+function anchorGlobPattern(pattern, path) {
+	if (path === void 0) return pattern;
+	if (!/^[^*?[\]{}!/]+(?=\/|$)/.test(pattern)) return pattern;
+	return `**/${pattern}`;
+}
+/**
 * Build the fixed `rg --files` argv for one `glob` call. Every
 * model-controlled value ({@link GlobInput.pattern}, {@link GlobInput.path})
 * is a plain argv element — no shell layer exists, so no quoting applies; the
@@ -574,13 +604,20 @@
 * --hidden` searches ignored and hidden files, and
 * {@link GLOB_VCS_EXCLUDES} keeps VCS metadata out.
 *
+* The pattern is anchored through {@link anchorGlobPattern} before the
+* `--glob=` element is built: under a `path` root a literal-first-segment
+* pattern is `**`-prefixed so ripgrep resolves it against that root instead of
+* the process CWD (where it would silently find nothing although the files
+* exist); basename-only, `**`-leading, metacharacter-first, leading-`/` and
+* no-`path` patterns pass through unchanged.
+*
 * @param input - the validated arguments.
 * @returns the complete ripgrep argument vector (excluding the binary itself).
 */
 function buildGlobCommand(input) {
 	const parts = [
 		"--files",
-		`--glob=${input.pattern}`,
+		`--glob=${anchorGlobPattern(input.pattern, input.path)}`,
 		"--sort=modified",
 		"--no-ignore",
 		"--hidden",
@@ -1265,4 +1302,4 @@
