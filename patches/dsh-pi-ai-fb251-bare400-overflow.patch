@@ -57,7 +59,12 @@
     /context[_ ]length[_ ]exceeded/i, // Generic fallback
     /too many tokens/i, // Generic fallback
     /token limit exceeded/i, // Generic fallback
-    /^4(?:00|13)\s*(?:status code)?\s*\(no body\)/i, // Cerebras: 400/413 with no body
+    // fb-251 bare-400: "400/413 status code (no body)" is the OpenAI SDK's GENERIC
+    // rendering of ANY upstream 400/413 with an empty body - provider-blind, so a
+    // bare no-body alone is NOT evidence of context overflow (it mislabeled
+    // non-context 400s as CONTEXT_WINDOW_EXCEEDED, driving useless compaction).
+    // Accept ONLY with real context/limit wording in the same message.
+    /^4(?:00|13)\s*(?:status code)?\s*\(no body\)[\s\S]*(?:\bcontext\b|\bwindow\b|\btoken\b|exceed|\blimit\b|\blength\b)/i, // Cerebras: 400/413 with no body + context-limit evidence
 ];
