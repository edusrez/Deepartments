+/* LOCAL PATCH (deepartments 2026-09-22) — wire tool-pairing guard (stages 1+2).
+   The upstream strict validator rejects two shapes with
+   400 "Messages with role 'tool' must be a response to a preceding message with
+   'tool_calls'" (or "insufficient tool messages following tool_calls"), and each
+   rejection kills a whole turn:
+     (1) ORPHAN  — a `tool` message whose id no preceding assistant issued;
+     (2) INTERLEAVED/DUPLICATE — a `tool` message that does not follow its issuing
+         assistant CONSECUTIVELY, or that answers an id already answered.
+   Both are produced ABOVE this layer. The live case (host session 15f80d86, t268+
+   onward, every turn failing at step 1) is shape (2): the mailbox/journal delivery
+   of a `dept_sleep` close lands a user message BETWEEN the assistant's tool_calls
+   and its tool result, and transformMessages' second pass then synthesizes a
+   "No result provided" answer before that user message, so the real result is
+   emitted afterwards as a duplicate, non-consecutive `tool` message.
+   This pass therefore mirrors the org's proven deepseek-serializer defence
+   (patches/dsh-llm-deepseek-orphan-sweep.patch + ...-toolcall-strip.patch) at the
+   only point that still knows what was actually emitted: the wire list itself.
+   Clean request shapes pass through byte-identical. */
+function __dshGuardToolPairing(params, compat) {
+    const out = [];
+    let active = null;    // ids del assistant actual que aún pueden responderse consecutivamente
+    let consumed = null;  // ids ya respondidos dentro de ese bloque
+    const findings = [];
+    const note = (kind, msg) => findings.push({ kind, toolCallId: msg?.tool_call_id ?? null, toolName: msg?.name ?? null });
+    for (let i = 0; i < params.length; i++) {
+        const msg = params[i];
+        if (msg.role === "assistant") {
+            const calls = msg.tool_calls ?? [];
+            active = null;
+            consumed = null;
+            if (calls.length > 0) {
+                const answered = new Set();
+                for (let j = i + 1; j < params.length && params[j].role === "tool"; j++) answered.add(params[j].tool_call_id);
+                if (calls.every((call) => answered.has(call.id))) {
+                    active = new Set(calls.map((call) => call.id));
+                    consumed = new Set();
+                    out.push(msg);
+                    continue;
+                }
+                // Sin respuesta consecutiva completa: se despoja el tool_calls (texto/razonamiento se conservan)
+                // para no dejar tampoco la clase opuesta ("insufficient tool messages following tool_calls").
+                const { tool_calls, ...kept } = msg;
+                note("strip-tool-calls-without-consecutive-results", { tool_call_id: calls.map((call) => call.id).join("|") });
+                const content = kept.content;
+                if (typeof content === "string" ? content.length > 0 : (content ?? []).length > 0) out.push(kept);
+                continue;
+            }
+            out.push(msg);
+            continue;
+        }
+        if (msg.role === "tool") {
+            if (active !== null && active.has(msg.tool_call_id) && !consumed.has(msg.tool_call_id)) {
+                consumed.add(msg.tool_call_id);
+                out.push(msg);
+                continue;
+            }
+            note(active === null ? "drop-orphan-or-interleaved-tool" : "drop-duplicate-tool", msg);
+            continue;
+        }
+        active = null;
+        consumed = null;
+        out.push(msg);
+    }
+    if (findings.length > 0) __dshGuardReport(params, findings, compat);
+    return out;
+}
+/** Registro forense del guardián: línea en stderr (journald) + append JSONL. Nunca lanza. */
+function __dshGuardReport(params, findings, compat) {
+    const summarize = (p) => p.role === "assistant" ? `assistant[tc:${(p.tool_calls ?? []).map((t) => t.id).join("|") || "-"}]` : p.role === "tool" ? `tool[${p.tool_call_id}]` : p.role;
+    const tail = params.map(summarize).slice(-16);
+    try {
+        process.stderr.write(`[dsh-guard-toolpair] ${findings.map((f) => `${f.kind}${f.toolCallId ? `:${f.toolCallId}` : ""}`).join(" ")} requiresToolResultName=${compat?.requiresToolResultName === true} wire=${params.length} tail=${tail.join(" ")}\n`);
+        import("node:fs").then(({ mkdirSync, appendFileSync }) => {
+            mkdirSync("/tmp/dsh-wire-guard", { recursive: true });
+            appendFileSync("/tmp/dsh-wire-guard/guard.jsonl", `${JSON.stringify({
+                at: new Date().toISOString(),
+                findings,
+                tail,
+                messages: params.map((p) => ({
+                    role: p.role,
+                    tool_call_id: p.tool_call_id,
+                    tool_calls: p.tool_calls?.map((t) => ({ id: t.id, name: t.function?.name })),
+                    contentLength: typeof p.content === "string" ? p.content.length : Array.isArray(p.content) ? p.content.length : 0,
+                })),
+            })}\n`);
+        }).catch(() => {});
+    }
+    catch { /* los diagnósticos nunca deben romper un request */ }
+}
