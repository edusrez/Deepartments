 /**
+* Defense-in-depth post-pass over the wire list: the strict DeepSeek API
+* requires tool responses to CONSECUTIVELY follow the assistant that issued
+* the tool_calls (one immediate set - no interleaved user/system messages).
+* Any assistant whose tool responses are missing, partial, or non-consecutive
+* would be rejected (400 "insufficient tool messages following tool_calls")
+* by the upstream validator; this pass STRIPS `tool_calls` from such an
+* assistant (text/reasoning kept) and drops the tool responses of the
+* stripped calls (they would otherwise be orphaned {role:'tool'} messages -
+* the Fix B 400 class). Clean consecutive pairs pass through byte-identical
+* (never mutated).
+*/
+function stripIncompleteToolCalls(wire) {
+	for (let i = 0; i < wire.length; i++) {
+		const assistant = wire[i];
+		if (assistant.role !== "assistant" || !Array.isArray(assistant.tool_calls) || assistant.tool_calls.length === 0) continue;
+		const required = assistant.tool_calls.map((toolCall) => toolCall.id);
+		const followed = new Set();
+		for (let j = i + 1; j < wire.length && wire[j].role === "tool"; j++) followed.add(wire[j].tool_call_id);
+		if (required.every((id) => followed.has(id))) continue;
+		delete assistant.tool_calls;
+		const stripped = new Set(required);
+		for (let k = wire.length - 1; k >= 0; k--) {
+			if (wire[k].role === "tool" && stripped.has(wire[k].tool_call_id)) wire.splice(k, 1);
+		}
+	}
+}
